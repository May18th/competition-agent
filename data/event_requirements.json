{
  "_说明": "各赛事的「要求卡」：文档类型 + 章节结构 + 评分权重。前端卡片读这份数据展示并允许修改，生成时按 structure 走。改完记得同步给后端（后端也会读它注入 prompt）。",
  "_来源": "iCAN：第十九届官网参赛材料要求 + 团队 2026 实际提交过的《护途CareWay 参赛项目计划书》docx 结构；其余：data/<赛事>.txt 的评分标准与申报书章节",

  "iCAN大学生创新创业大赛": {
    "doc_type": "作品说明书（参赛项目计划书）",
    "alias": ["ican", "ican大赛", "ican大学生", "创新创业"],
    "封面字段": ["作品名称", "一句话副标题", "项目类型", "参赛对象", "版本"],
    "structure": [
      {"id": "s1", "title": "一、项目概述", "subs": ["（一）背景与行业痛点", "（二）项目定位"], "must": true},
      {"id": "s2", "title": "二、市场与需求分析", "subs": ["（一）行业/人群规模", "（二）目标人群构成", "（三）核心痛点场景", "（四）目标市场与规模估算"], "must": true},
      {"id": "s3", "title": "三、项目创新性分析", "subs": ["（一）创新点一", "（二）创新点二", "（三）创新点三", "（四）创新点四"], "must": true,
       "note": "每条要写清「与现有方案的差异」，不能只喊口号"},
      {"id": "s4", "title": "四、技术方案与系统架构", "subs": ["（一）总体架构", "（二）核心功能模块", "（三）关键技术"], "must": true},
      {"id": "s5", "title": "五、产品形态与现场演示方案", "subs": ["（一）产品组件（配表）", "（二）现场演示闭环"], "must": true,
       "note": "iCAN 要求能演示的实物或原型，这章是打分重点"},
      {"id": "s6", "title": "六、商业模式", "subs": ["（一）付费对象与收费模式", "（二）市场空间与成长性", "（三）竞争壁垒"], "must": false},
      {"id": "s7", "title": "七、实施路径与团队规划", "subs": ["（一）分阶段实施路径", "（二）团队分工"], "must": true},
      {"id": "s8", "title": "八、与大赛评审标准对标", "subs": ["评分维度 / 分值 / 本项目对应策略（表格）"], "must": true,
       "note": "把下面 scoring 的五个维度逐条对上，评委最容易加分"},
      {"id": "s9", "title": "结语", "subs": [], "must": false}
    ],
    "scoring": [
      {"name": "创新性", "weight": 30, "hint": "技术或应用模式是否原创，是否突破现有方案"},
      {"name": "技术实现", "weight": 30, "hint": "技术方案可行性、复杂度与先进性，能否落地演示"},
      {"name": "实用价值", "weight": 20, "hint": "是否解决真实痛点，有无可落地场景与用户价值"},
      {"name": "用户体验", "weight": 10, "hint": "易用性、交互设计、现场使用感受"},
      {"name": "展示效果", "weight": 10, "hint": "现场演示完整度、路演表达与作品呈现"}
    ],
    "official_requires": [
      "作品简介：简要阐述作品功能与服务",
      "作品核心创新点：区别于其他产品的核心突破（技术/模式/管理）",
      "作品市场前景：实用性与市场应用价值",
      "团队成员及分工",
      "财务状况及融资计划（无则填无）"
    ],
    "deduct": [
      "缺乏原创性，只是已有产品的简单复制或组合",
      "技术方案空洞，没有具体实现细节和可行性分析",
      "只讲概念，没有落地场景或 demo 验证",
      "内容单薄、章节缺失、逻辑不连贯",
      "痛点泛泛而谈，没有具体数据和真实场景"
    ],
    "格式": {"页数": "建议 15-25 页", "正文": "宋体小四", "必须配图": true, "必须配表": true}
  },

  "挑战杯全国大学生课外学术科技作品竞赛": {
    "doc_type": "申报书（学术论文/科技发明类）",
    "alias": ["挑战杯", "课外学术科技作品"],
    "structure": [
      {"id": "s1", "title": "一、项目概述", "subs": ["研究背景", "研究意义"], "must": true},
      {"id": "s2", "title": "二、国内外研究现状", "subs": ["现有方案综述", "存在不足"], "must": true},
      {"id": "s3", "title": "三、研究内容与方法", "subs": ["技术路线", "实验/实现方法"], "must": true},
      {"id": "s4", "title": "四、创新点与成果", "subs": ["理论/技术创新", "作品成果（专利/论文/样机）"], "must": true},
      {"id": "s5", "title": "五、应用前景与社会价值", "subs": [], "must": true},
      {"id": "s6", "title": "六、团队与进度安排", "subs": [], "must": false}
    ],
    "scoring": [
      {"name": "科学性", "weight": 30, "hint": "理论依据、方法合理性"},
      {"name": "先进性", "weight": 30, "hint": "创新程度、技术水平"},
      {"name": "现实意义", "weight": 40, "hint": "应用价值、社会影响"}
    ],
    "deduct": ["缺少文献综述", "创新点不清晰", "无数据或实验支撑"]
  },

  "中国国际互联网+大学生创新创业大赛": {
    "doc_type": "商业计划书",
    "alias": ["互联网+", "互联网+大赛", "中国国际大学生创新大赛"],
    "structure": [
      {"id": "s1", "title": "一、项目概述", "subs": ["痛点", "解决方案"], "must": true},
      {"id": "s2", "title": "二、市场分析", "subs": ["市场规模", "竞品对比"], "must": true},
      {"id": "s3", "title": "三、产品与技术方案", "subs": [], "must": true},
      {"id": "s4", "title": "四、商业模式", "subs": ["盈利模式", "营销策略"], "must": true},
      {"id": "s5", "title": "五、财务预测与融资计划", "subs": [], "must": true},
      {"id": "s6", "title": "六、团队与教育维度", "subs": ["团队分工", "带动就业/教育价值"], "must": true},
      {"id": "s7", "title": "七、社会价值", "subs": [], "must": true}
    ],
    "scoring": [
      {"name": "商业性", "weight": 30, "hint": "商业模式、盈利与成长性"},
      {"name": "创新性", "weight": 25, "hint": "产品/技术/模式创新"},
      {"name": "团队", "weight": 20, "hint": "团队能力与分工"},
      {"name": "就业与社会价值", "weight": 15, "hint": "带动就业、教育意义"},
      {"name": "引领教育", "weight": 10, "hint": "专创融合、示范作用"}
    ],
    "deduct": ["商业模式不成立", "财务数据拍脑袋", "缺少教育维度"]
  }
}
