# shell 脚本必须保持 LF：本机 core.autocrlf=true，检出成 CRLF 后 bash 会报
# "$'\r': command not found"，脚本直接跑不起来。
*.sh text eol=lf

# 二进制文件不做行尾转换，也不做文本 diff（避免行尾污染和 diff 噪音）
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.gif  binary
*.webp binary
*.docx binary
*.pptx binary
*.pdf  binary
*.zip  binary
*.db   binary
*.sqlite binary
*.so   binary
*.woff2 binary
